# ====================================================================
# AI ENGINEER ASSESSMENT: ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT PRODUCTION SECRETS OR REAL PII TO REPOSITORY
# ====================================================================

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Voice Platform & Telephony (Optional: Twilio / LiveKit / WebRTC)
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_template
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_template
TWILIO_CALLABLE_PHONE_NUMBER=+18005550199
WEBRTC_SIGNALING_URL=ws://127.0.0.1:8000/ws/call

# Speech-to-Text (ASR) Providers
SPEECH_ASR_PROVIDER=hybrid_local_whisper
OPENAI_API_KEY=sk-mock-openai-key-for-whisper-v3
AZURE_SPEECH_KEY=mock-azure-cognitive-services-key
AZURE_SPEECH_REGION=southeastasia
GOOGLE_APPLICATION_CREDENTIALS=config/mock_gcp_service_account.json

# Text-to-Speech (TTS) Providers
SPEECH_TTS_PROVIDER=windows_sapi_azure_fallback
AZURE_TTS_VOICE_EN=en-US-JennyNeural
AZURE_TTS_VOICE_PH=fil-PH-BlessicaNeural
AZURE_TTS_VOICE_ID=id-ID-ArdiNeural

# Vector Store & Retrieval
RETRIEVAL_HYBRID_BM25_WEIGHT=0.40
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.60
MIN_CONFIDENCE_THRESHOLD=0.35

# Real-Time Nudges Engine Guardrails
NUDGE_CONFIDENCE_THRESHOLD=0.75
NUDGE_COOLDOWN_CROSS_SELL_SEC=45
NUDGE_COOLDOWN_COMPLIANCE_SEC=15
NUDGE_COOLDOWN_FRUSTRATION_SEC=30
NUDGE_TTL_SECONDS=30

# Mock CRM Webhook
CRM_DATABASE_FILE=data/crm_leads.json
CRM_WEBHOOK_URL=http://127.0.0.1:8000/api/crm/lead
